{
  "manifest_version": 3,
  "name": "PokéStop & Gym Planning Grid",
  "version": "1.2.0",
  "description": "Shows PokéStop and Gym planning grids on Scopely Wayfarer maps",
  "permissions": ["activeTab", "storage", "sidePanel"],
  "host_permissions": ["*://wayfarer.scopely.com/*"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/favicon-16x16.png",
      "32": "icons/favicon-32x32.png"
    }
  },
  "side_panel": {
    "default_path": "pages/nominations.html"
  },
  "icons": {
    "16": "icons/favicon-16x16.png",
    "32": "icons/favicon-32x32.png"
  },
  "content_scripts": [
    {
      "matches": ["*://wayfarer.scopely.com/*"],
      "js": ["scripts/wayfarer-config.js", "scripts/bridge.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["*://wayfarer.scopely.com/*"],
      "js": ["scripts/wayfarer-config.js", "scripts/emoji.js", "scripts/s2geometry.js", "scripts/l14-analysis.js", "scripts/content.js"],
      "css": ["styles/overlay.css"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles/overlay.css"],
      "matches": ["*://wayfarer.scopely.com/*"]
    }
  ]
}
